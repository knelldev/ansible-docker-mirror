# .gitignore
## ansible
*.retry
.ansible/
collections/ansible_collections/
.skel-out/
*.tar.gz

## macos
.DS_store

## vscode
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json

## logs
logs/
*.log

## python
__pycache__/
.pytest_cache/
*.egg-info/

## development stuff
_tmp/
.validation-logs/
.ruff_cache/
.mypy_cache/
.coverage

## ai working material
.ai/cache/
.ai/scratch/
.ai/.tmp/
.ai/SESSION_FEEDBACK_*.md

## opencode local dependencies
.opencode/node_modules/
.opencode/package.json
.opencode/package-lock.json
