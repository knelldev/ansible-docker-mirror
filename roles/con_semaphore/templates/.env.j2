# Postgres container config
POSTGRES_USER={{ con_semaphore_db_user }}
POSTGRES_PASSWORD={{ con_semaphore_db_password }}
POSTGRES_DB={{ con_semaphore_db_name }}

# Semaphore container confi
# Set the login details of the initial admin user.
SEMAPHORE_ADMIN_PASSWORD={{ con_semaphore_admin_password }}
SEMAPHORE_ADMIN_NAME={{ con_semaphore_admin_user }}
SEMAPHORE_ADMIN_EMAIL={{ con_semaphore_admin_user }}
SEMAPHORE_ADMIN={{ con_semaphore_admin_name }}
SEMAPHORE_DB_HOST=semaphore_postgres
SEMAPHORE_DB_USER={{ con_semaphore_db_user }}
SEMAPHORE_DB_PASS={{ con_semaphore_db_password }}
SEMAPHORE_DB={{ con_semaphore_db_name }}
SEMAPHORE_DB_PORT=5432
SEMAPHORE_DB_DIALECT=postgres
SEMAPHORE_PLAYBOOK_PATH=/tmp/semaphore/
