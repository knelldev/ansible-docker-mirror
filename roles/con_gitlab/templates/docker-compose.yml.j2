services:
  gitlab:
    image: gitlab/{{ con_gitlab_edition }}:{{ con_gitlab_version }}
    container_name: gitlab
    restart: unless-stopped
    hostname: '{{ con_gitlab_domain }}'
    environment:
      GITLAB_POST_RECONFIGURE_SCRIPT: /etc/gitlab/post-reconfigure.sh
    ports:
      - '80:80'
      - '443:443'
      - '2022:22'
    volumes:
      - '{{ app_path }}/config:/etc/gitlab:Z'
      - '{{ app_path }}/logs:/var/log/gitlab:Z'
      - '{{ app_path }}/data:/var/opt/gitlab:Z'
      - '{{ app_path }}/ca-custom:/usr/local/share/ca-certificates:Z'
    shm_size: '256m'
