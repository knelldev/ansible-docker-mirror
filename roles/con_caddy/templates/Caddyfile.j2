# {{ ansible_managed }}
{
	email {{ con_caddy_acme_email }}
{% if con_caddy_acme_challenge == 'dns' %}
	# Default issuers (Let's Encrypt, then ZeroSSL) with DNS-01. cert_issuer
	# instead of acme_dns, so sites with acme_challenge http keep HTTP-01.
	cert_issuer acme {
		dns cloudflare {env.CF_API_TOKEN}
	}
	cert_issuer acme https://acme.zerossl.com/v2/DV90 {
		dns cloudflare {env.CF_API_TOKEN}
	}
{% endif %}
{% if con_caddy_cert_wildcards | length > 0 %}
	tls_automate_names {{ con_caddy_cert_wildcards | join(' ') }}
{% endif %}
{% if con_caddy_proxy_protocol_allow | length > 0 %}
	servers :443 {
		listener_wrappers {
			proxy_protocol {
				allow {{ con_caddy_proxy_protocol_allow | join(' ') }}
			}
			tls
		}
	}
{% endif %}
{% if con_caddy_global_options_extra | trim | length > 0 %}
{{ con_caddy_global_options_extra | trim | regex_replace('(?m)^(?=.)', '\t') }}
{% endif %}
}

(common) {
	encode zstd gzip
	log {
		output file /var/log/caddy/access.log
		format json
	}
	# Errors raised by Caddy itself (unreachable upstream, blocked path, ...).
	# Upstream responses and forward auth replies pass through unchanged.
	handle_errors {
		root * /srv/errors
		rewrite * /error.html
		templates
		file_server {
			status {err.status_code}
		}
	}
}
{% if con_caddy_extra_config | trim | length > 0 %}

{{ con_caddy_extra_config | trim }}
{% endif %}

# Custom snippets and site blocks dropped into <app_path>/conf/conf.d.
import /etc/caddy/conf.d/*.caddy
{% for site in con_caddy_sites %}
{% set challenge = site.acme_challenge | default(con_caddy_acme_challenge) %}
{% set security_headers = {} if site.security_headers | default({}) is sameas false else con_caddy_security_headers | combine(site.security_headers | default({})) %}

{{ ([site.name] + site.aliases | default([])) | join(', ') }} {
	import common
{% if challenge != con_caddy_acme_challenge %}
	tls {
{% if challenge == 'dns' %}
		dns cloudflare {env.CF_API_TOKEN}
{% else %}
		issuer acme
		issuer acme https://acme.zerossl.com/v2/DV90
{% endif %}
	}
{% endif %}
{% for key, value in security_headers.items() if value is not none and value | string | length > 0 %}
	header ?{{ key }} "{{ value }}"
{% endfor %}
{% for key, value in (site.headers_down | default({})).items() %}
	header {{ key }} "{{ value }}"
{% endfor %}
{% if site.cors_origins | default([]) | length > 0 %}
	@cors_origin {
{% for origin in site.cors_origins %}
		header Origin {{ origin }}
{% endfor %}
	}
	header @cors_origin {
		defer
		Access-Control-Allow-Origin "{http.request.header.Origin}"
		Access-Control-Allow-Methods "{{ site.cors_methods | default(['GET', 'POST', 'PUT', 'PATCH', 'DELETE', 'OPTIONS']) | join(', ') }}"
		Access-Control-Allow-Headers "{http.request.header.Access-Control-Request-Headers}"
		Vary Origin
	}
	@cors_preflight {
		method OPTIONS
{% for origin in site.cors_origins %}
		header Origin {{ origin }}
{% endfor %}
	}
	handle @cors_preflight {
		respond 204
	}
{% endif %}
{% if site.noindex | default(con_caddy_noindex) %}
	header X-Robots-Tag "noindex, nofollow"
	handle /robots.txt {
		respond "User-agent: *
Disallow: /
" 200
	}
{% endif %}
{% if site.block_paths | default([]) | length > 0 %}
	@blocked path {{ site.block_paths | join(' ') }}
	handle @blocked {
		error 404
	}
{% endif %}
{% if site.extra_config | default('') | trim | length > 0 %}
{{ site.extra_config | trim | regex_replace('(?m)^(?=.)', '\t') }}
{% endif %}
{% for response in site.responses | default([]) %}
	handle {{ response.path }} {
		header Content-Type "{{ response.content_type | default('text/plain; charset=utf-8') }}"
		respond `{{ response.body }}` {{ response.status | default(200) }}
	}
{% endfor %}
	handle {
{% if site.redirect is defined %}
		redir {{ site.redirect }}
{% else %}
		route {
{% if site.auth | default('') | length > 0 %}
{% set provider = con_caddy_forward_auth_all[site.auth] %}
{% if provider.proxy_paths | default([]) | length > 0 %}
			@auth_provider path {{ provider.proxy_paths | join(' ') }}
			reverse_proxy @auth_provider {{ provider.url }}
{% endif %}
{% if site.auth_skip_paths | default([]) | length > 0 %}
			@auth not path {{ site.auth_skip_paths | join(' ') }}
{% endif %}
			forward_auth {{ '@auth ' if site.auth_skip_paths | default([]) | length > 0 else '' }}{{ provider.url }} {
				uri {{ provider.uri }}
{% if provider.copy_headers | default([]) | length > 0 %}
				copy_headers {{ provider.copy_headers | join(' ') }}
{% endif %}
				trusted_proxies private_ranges
{% if provider.extra_config | default('') | trim | length > 0 %}
{{ provider.extra_config | trim | regex_replace('(?m)^(?=.)', '\t\t\t\t') }}
{% endif %}
			}
{% endif %}
			reverse_proxy {{ [site.upstream] | flatten | join(' ') }} {
{% if site.lb_policy is defined %}
				lb_policy {{ site.lb_policy }}
{% endif %}
{% if site.upstream_tls | default('') == 'skip_verify' %}
				transport http {
					tls_insecure_skip_verify
				}
{% endif %}
{% if site.proxy_extra_config | default('') | trim | length > 0 %}
{{ site.proxy_extra_config | trim | regex_replace('(?m)^(?=.)', '\t\t\t\t') }}
{% endif %}
			}
		}
{% endif %}
	}
}
{% endfor %}
