# {{ ansible_managed }}
[commands]
# Set the type of updates to apply. Options are:
# default - all updates
# security - security updates only
# bugfix - bugfix updates only
# enhancement - enhancement updates only
# newpackage - install new packages when updates introduce them
# distro-sync - apply all updates as a distro-sync
upgrade_type = {{ dnf_automatic_upgrade_type }}

# Apply updates automatically
apply_updates = {{ 'yes' if dnf_automatic_apply_updates | bool else 'no' }}

# Automatically reboot if required after an update
# Reboot type can be (dnf 4):
# - 'never': Never reboot automatically
# - 'when-changed': Reboot after any applied update
# - 'when-needed': Reboot only if necessary
reboot = {{ dnf_automatic_reboot }}

[emitters]
# Disable all notification methods
emit_via = motd

# Motd (Message of the Day) configuration
# Note: 'motd' will show a message on the login screen, no emails will be sent
motd = yes

[base]
# Set the debug level (1-10)
debuglevel = 1

# Log messages to the system log
# Use 'journal' to log messages to the system journal
# Use 'syslog' to log messages to syslog
# 'syslog' requires the syslog service to be running
log = journal

[download]
# dnf 4 reads download_updates only in [commands], so this section has no
# effect and runs without apply_updates only check and report (as before).
# Automatically download updates (without applying)
download_updates = yes

# Save downloaded updates in a cache (for later manual installation)
# If set to 'yes', updates will not be removed from cache after installation
save_before_exit = no
