# Managed by Ansible (os_prepare). dnf 4 dnf-automatic, see
# https://dnf.readthedocs.io/en/latest/automatic.html
[commands]
# Type of updates to apply: default (all) | security | bugfix | ...
upgrade_type = {{ dnf_automatic_upgrade_type }}

# Download and apply updates
download_updates = yes
apply_updates = {{ 'yes' if dnf_automatic_apply_updates | bool else 'no' }}

# When to reboot after upgrades: never | when-changed | when-needed
reboot = {{ dnf_automatic_reboot }}

[emitters]
# Show the result in the message of the day only, no mail
emit_via = motd

[base]
# Overrides for dnf.conf
debuglevel = 1
