# Managed by Ansible (os_container)
[Unit]
Description=Lowest port unprivileged processes may bind
After=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/sysctl -w net.ipv4.ip_unprivileged_port_start={{ os_container_unprivileged_port_start }}

[Install]
WantedBy=multi-user.target
