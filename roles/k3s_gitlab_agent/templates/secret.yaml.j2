# {{ ansible_managed }}
# Token Secret of agent {{ agent_item.name }}; the chart mounts it by name.
apiVersion: v1
kind: Secret
type: Opaque
metadata:
  name: {{ k3s_gitlab_agent_item_secret_name | to_json }}
  namespace: {{ k3s_gitlab_agent_item_namespace | to_json }}
  labels:
    app.kubernetes.io/managed-by: ansible
    app.kubernetes.io/instance: {{ agent_item.name | to_json }}
  annotations:
    {{ k3s_gitlab_agent_token_id_annotation }}: {{ k3s_gitlab_agent_new_token.json.id | string | to_json }}
    {{ k3s_gitlab_agent_agent_id_annotation }}: {{ k3s_gitlab_agent_item_id | to_json }}
data:
  token: {{ k3s_gitlab_agent_new_token.json.token | b64encode | to_json }}
